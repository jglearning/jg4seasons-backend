# 로컬 개발 설정 예시. 복사해서 쓴다(application-local.yml은 git에 올라가지 않는다):
#   cp src/main/resources/application-local.yml.example src/main/resources/application-local.yml
#   docker compose up -d
#   ./gradlew bootRun --args='--spring.profiles.active=local'
# local 프로파일에서는 개발용 시드(데모 학원·반·진도표·학생)가 처음 한 번 들어간다.
spring:
  datasource:
    url: jdbc:mysql://localhost:3307/jg4seasons
    username: jg4seasons
    password: local-only

springdoc:
  api-docs:
    # 로컬에서는 /v3/api-docs로 명세를 볼 수 있다(운영은 꺼짐)
    enabled: true
