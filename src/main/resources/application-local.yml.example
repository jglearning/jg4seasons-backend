# 로컬 개발 설정 예시. 복사해서 쓴다(application-local.yml은 git에 올라가지 않는다):
#   cp src/main/resources/application-local.yml.example src/main/resources/application-local.yml
#   docker compose up -d
#   ./gradlew bootRun --args='--spring.profiles.active=local'
# local 프로파일에서는 개발용 시드(데모 학원·반·진도표·학생)가 처음 한 번 들어간다.
spring:
  datasource:
    url: jdbc:mysql://localhost:3307/jg4seasons
    username: jg4seasons
    password: local-only

springdoc:
  api-docs:
    # 로컬에서는 /v3/api-docs로 명세를 볼 수 있다(운영은 꺼짐)
    enabled: true

jg4seasons:
  auth:
    # 로컬 전용 값(비밀 아님). 운영은 환경 변수 JG4SEASONS_PERSONAL_CODE_PEPPER·JG4SEASONS_JWT_SECRET
    personal-code-pepper: ${JG4SEASONS_PERSONAL_CODE_PEPPER:local-only-pepper-0123456789abcdef}
    jwt-secret: ${JG4SEASONS_JWT_SECRET:local-only-jwt-secret-0123456789abcdef}
    # 로컬은 http라 Secure 쿠키를 끈다
    cookie-secure: false
